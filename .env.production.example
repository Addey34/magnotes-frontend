# Public API endpoint injected at build time. Copy to .env.production locally.
VITE_API_URL=https://api-magnotes.adrianguichard.dev

# Privacy-first Umami analytics (optional). Leave unset to disable tracking.
# Fill after deploying the Umami stack (server: compose.analytics.yml) and
# creating the website in the Umami dashboard. The src origin must match the
# CSP in firebase.json.
VITE_UMAMI_SRC=https://analytics-magnotes.adrianguichard.dev/script.js
VITE_UMAMI_WEBSITE_ID=
